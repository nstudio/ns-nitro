// You can add custom settings here
// for example you can uncomment the following line to force distribution code signing
// CODE_SIGN_IDENTITY = iPhone Distribution 
// To build for device with XCode you need to specify your development team.
// DEVELOPMENT_TEAM = YOUR_TEAM_ID;
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon;
IPHONEOS_DEPLOYMENT_TARGET = 16.0;
SWIFT_VERSION = 5.0;
CLANG_CXX_LANGUAGE_STANDARD = gnu++20;
GCC_OPTIMIZATION_LEVEL = 3;
SWIFT_OPTIMIZATION_LEVEL = -O;
HEADER_SEARCH_PATHS = $(inherited) "$(SRCROOT)/nsnitro/src" "$(SRCROOT)/../../App_Resources/iOS/src" "$(CONFIGURATION_BUILD_DIR)/NativeScript.framework/Headers" "$(CONFIGURATION_BUILD_DIR)/NativeScript.framework/Headers/include" "$(CONFIGURATION_BUILD_DIR)/NativeScript.framework/Headers/runtime" "$(CONFIGURATION_BUILD_DIR)/NativeScript.framework/Headers/third_party"
